APP_ENV=local
DATABASE_URL=sqlite:///./data/app.db
OBJECT_STORAGE_DIR=./data/objects
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=doc/deepseek api.txt
DEEPSEEK_MODEL=deepseek-v4-flash
GITHUB_TOKEN=
GITHUB_PROVIDER=mock
MODEL_PROVIDER=mock
TTS_PROVIDER=mock
# Real Chinese narration: minimax (mmx-cli Token Plan) or edge_tts. Local fallback: windows_sapi. Tests use mock.
# TTS_PROVIDER=edge_tts
# MODEL_PROVIDER=minimax
MINIMAX_CLI_PATH=mmx
MINIMAX_CLI_REGION=cn
MINIMAX_TEXT_MODEL=MiniMax-M2.7
MINIMAX_RUNTIME_TMP_DIR=data/runtime_tmp
# Optional pay-as-you-go HTTP TTS path: TTS_PROVIDER=minimax_http
MINIMAX_API_KEY=
MINIMAX_API_KEY_FILE=doc/minimax token.txt
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_ENDPOINT=https://api.minimax.io/v1/t2a_v2
MINIMAX_TTS_VOICE_ID=Chinese (Mandarin)_Sweet_Lady
RENDER_PROVIDER=fake
